# Copie para .env só se quiser trocar algum valor. Sem .env, o docker compose usa estes padrões.

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=torneios
MYSQL_USER=torneios
MYSQL_PASSWORD=torneios
# Porta do MySQL no seu computador (3307 para não brigar com um MySQL local na 3306)
MYSQL_PORTA_HOST=3307

# API (fora do Docker, aponte para o MySQL do compose: DB_HOST=localhost e DB_PORT=3307)
DB_HOST=localhost
DB_PORT=3307
API_PORTA=3000

# Site oficial simulado
SITE_PORTA=4000
# Demora de cada consulta, em milissegundos (padrão do site real: 2 a 10 segundos).
# Para a demonstração, algo como 200 e 800 deixa a conferência rápida.
SITE_DEMORA_MIN_MS=2000
SITE_DEMORA_MAX_MS=10000

# Conferência na API (fora do Docker, aponte para o site local: SITE_URL=http://localhost:4000)
SITE_URL=http://localhost:4000
# Depois disso a consulta conta como "site sem resposta" e é tentada de novo.
# Precisa ser maior que SITE_DEMORA_MAX_MS; a API não sobe se não for.
SITE_TEMPO_LIMITE_MS=15000
# Espera antes de cada nova tentativa, em milissegundos (D10: 1, 2, 5 e depois 10 minutos).
# Para a demonstração, algo como 2000,4000,8000.
CONFERENCIA_INTERVALOS_MS=60000,120000,300000,600000
