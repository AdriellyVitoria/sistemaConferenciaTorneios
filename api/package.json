{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "API do sistema de premiação: importação, conferência e cálculo",
  "main": "dist/servidor.js",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/servidor.js",
    "migrar": "tsx src/banco/migrar.ts",
    "test": "vitest run",
    "test:integracao": "vitest run -c vitest.integracao.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "knex": "^3.1.0",
    "mysql2": "^3.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.4"
  }
}
